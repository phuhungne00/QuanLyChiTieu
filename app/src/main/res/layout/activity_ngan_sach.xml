<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootNganSach"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ngan_sach_thang"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNganSach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ngan_sach_hint"
            android:inputType="number"
            android:maxLength="13" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swCanhBao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/bat_canh_bao" />

        <TextView
            android:id="@+id/tvNguong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <SeekBar
            android:id="@+id/skNguong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50" />

        <Button
            android:id="@+id/btnLuuNganSach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/luu" />

        <Button
            android:id="@+id/btnThuThongBao"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gui_thu_thong_bao" />
    </LinearLayout>
</ScrollView>
