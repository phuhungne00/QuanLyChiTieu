<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMucTieu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvMucTieu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#DDDDDD"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/tvTrongMucTieu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/chua_co_muc_tieu"
            android:textColor="@color/ct_chu_phu" />
    </FrameLayout>

    <Button
        android:id="@+id/btnThemMucTieu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/them_muc_tieu_btn" />
</LinearLayout>
