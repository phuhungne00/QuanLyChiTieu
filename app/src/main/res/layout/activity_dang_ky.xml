<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootDangKy"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dang_ky_mo_ta"
            android:textColor="@color/ct_chu_phu" />

        <EditText
            android:id="@+id/etHoTenDk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/ho_ten"
            android:inputType="textPersonName|textCapWords" />

        <EditText
            android:id="@+id/etTenDangNhapDk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/ten_dang_nhap_goi_y"
            android:inputType="textNoSuggestions"
            android:maxLength="20" />

        <EditText
            android:id="@+id/etMatKhauDk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/mat_khau_goi_y"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/etNhapLaiDk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/nhap_lai_mat_khau"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btnDangKy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dang_ky" />
    </LinearLayout>
</ScrollView>
